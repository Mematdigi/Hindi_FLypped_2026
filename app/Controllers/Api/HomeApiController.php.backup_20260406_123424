    /**
     * GET /api/v1/search?q=keyword&page=1&per_page=10
     */
    public function search()
    {
        try {
            $q = trim((string) ($this->request->getGet('q') ?? ''));
            $page = max(1, (int) ($this->request->getGet('page') ?? 1));
            $perPage = min(50, max(1, (int) ($this->request->getGet('per_page') ?? 10)));
            $offset = ($page - 1) * $perPage;
            
            if (mb_strlen($q) < 2) {
                return $this->respond([
                    'success' => true,
                    'message' => 'Query too short (minimum 2 characters)',
                    'data' => [],
                    'pagination' => [
                        'total' => 0,
                        'page' => $page,
                        'per_page' => $perPage,
                        'total_pages' => 0
                    ]
                ]);
            }
            
            $like = '%' . $this->db->escapeLikeString($q) . '%';
            
            // Count total
            $countSql = "
                SELECT COUNT(DISTINCT p.ID) AS total
                FROM wp_posts p
                INNER JOIN wp_term_relationships tr ON p.ID = tr.object_id
                INNER JOIN wp_term_taxonomy tt ON tr.term_taxonomy_id = tt.term_taxonomy_id 
                    AND tt.taxonomy = 'category'
                INNER JOIN wp_terms t ON tt.term_id = t.term_id
                WHERE p.post_status = 'publish'
                  AND p.post_type = 'post'
                  AND (p.post_title LIKE ? OR p.post_content LIKE ?)
            ";
            $total = (int) ($this->db->query($countSql, [$like, $like])->getRow()->total ?? 0);
            
            // Get results
            $sql = "
                SELECT 
                    p.ID, p.post_title, p.post_name, p.post_date, p.post_excerpt, p.post_content,
                    t.slug AS category_slug,
                    t.name AS category_name,
                    thumb.guid AS thumbnail_url,
                    author.display_name AS author_name
                FROM wp_posts p
                INNER JOIN wp_term_relationships tr ON p.ID = tr.object_id
                INNER JOIN wp_term_taxonomy tt ON tr.term_taxonomy_id = tt.term_taxonomy_id 
                    AND tt.taxonomy = 'category'
                INNER JOIN wp_terms t ON tt.term_id = t.term_id
                LEFT JOIN wp_postmeta pm ON p.ID = pm.post_id AND pm.meta_key = '_thumbnail_id'
                LEFT JOIN wp_posts thumb ON pm.meta_value = thumb.ID
                LEFT JOIN wp_users author ON p.post_author = author.ID
                WHERE p.post_status = 'publish'
                  AND p.post_type = 'post'
                  AND (p.post_title LIKE ? OR p.post_content LIKE ?)
                GROUP BY p.ID
                ORDER BY p.post_date DESC
                LIMIT ? OFFSET ?
            ";
            
            $rows = $this->db->query($sql, [$like, $like, $perPage, $offset])->getResultArray();
            
            $results = [];
            foreach ($rows as $post) {
                $cat = strtolower(trim((string)($post['category_slug'] ?? ''), '/'));
                $slug = trim((string)($post['post_name'] ?? ''), '/');
                
                if (empty($cat)) {
                    continue;
                }
                
                $results[] = [
                    'ID' => (int)$post['ID'],
                    'post_title' => $post['post_title'],
                    'post_excerpt' => $post['post_excerpt'] ?? '',
                    'post_content' => $post['post_content'] ?? '',
                    'post_date' => $post['post_date'],
                    'author_name' => $post['author_name'] ?? 'Unknown',
                    'category_slug' => $cat,
                    'category_name' => $post['category_name'] ?? '',
                    'thumbnail_url' => $post['thumbnail_url'] ?? base_url('assets/images/default-thumbnail.jpg'),
                    'url' => base_url($cat . '/' . $slug)
                ];
            }
            
            return $this->respond([
                'success' => true,
                'query' => $q,
                'data' => $results,
                'pagination' => [
                    'total' => $total,
                    'page' => $page,
                    'per_page' => $perPage,
                    'total_pages' => ceil($total / $perPage)
                ]
            ]);
            
        } catch (\Exception $e) {
            log_message('error', 'API search Exception: ' . $e->getMessage());
            return $this->failServerError('Internal server error');
        }
    }
    
