    $routes->get('post/(:num)', 'HomeApiController::post/$1');
    $routes->get('post/(:segment)/(:segment)', 'HomeApiController::postBySlug/$1/$2');
    $routes->get('related/(:num)', 'HomeApiController::relatedPosts/$1');
    $routes->get('url', 'HomeApiController::postByUrl');

     // Author/User Management Routes
    
    // Get all users
    $routes->get('authors', 'AuthorController::index');
    
    // Get single user by ID
    $routes->get('authors/(:num)', 'AuthorController::show/$1');
    
    // Create new user
    $routes->post('authors', 'AuthorController::create');
    
    // Update user
    $routes->put('authors/(:num)', 'AuthorController::update/$1');
    $routes->patch('authors/(:num)', 'AuthorController::update/$1');
    
    // Delete user
    $routes->delete('authors/(:num)', 'AuthorController::delete/$1');
    
    // Get user posts
    $routes->get('authors/(:num)/posts', 'AuthorController::getUserPosts/$1');
    
    // Get user statistics
    $routes->get('authors/(:num)/stats', 'AuthorController::getUserStats/$1');
    
    // Search users
    $routes->get('authors/search', 'AuthorController::search');
});

